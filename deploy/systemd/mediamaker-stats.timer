[Unit]
Description=Refresh dashboard stats every 15 minutes

[Timer]
# Calendar-based, NOT OnUnitActiveSec. A relative timer computes its next run
# from the last service activation, so if that chain breaks the timer strands
# with "Trigger: n/a" and never fires again -- which is exactly what happened
# between 2026-07-30 and 2026-08-06. A calendar spec always has a next run.
OnCalendar=*:0/15
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
