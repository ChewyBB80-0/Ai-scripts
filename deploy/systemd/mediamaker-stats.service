[Unit]
Description=Media Maker stats refresh (dashboard data only)

[Service]
Type=oneshot
WorkingDirectory=%h/media_maker
EnvironmentFile=%h/media_maker/.env
# Stats only -- deliberately NOT the posting pipeline, so the dashboard can
# stay current without touching upload quota or the posting cadence.
ExecStart=%h/media_maker/venv/bin/python scripts/channel_stats.py
ExecStart=%h/media_maker/venv/bin/python scripts/ig_stats.py
ExecStart=%h/media_maker/venv/bin/python scripts/gen_dashboard.py
